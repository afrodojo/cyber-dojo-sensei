{
  "name": "Auto-Generate Social Posts on Publish",
  "description": "Generates LinkedIn, Twitter, and Facebook draft posts whenever a blog article is published",
  "trigger": {
    "condition": "${ ((.trigger.data.published == true) and (.trigger.changed_fields | index(\"published\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "BlogPost"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_generate_social_posts_on_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSocialPostsFromBlog",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateSocialPostsFromBlog"
  }
}