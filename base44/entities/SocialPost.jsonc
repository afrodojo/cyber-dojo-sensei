{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "twitter",
        "facebook",
        "instagram",
        "tiktok"
      ],
      "description": "Target social media platform"
    },
    "content": {
      "type": "string",
      "description": "Post content/copy"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "published",
        "failed"
      ],
      "default": "draft",
      "description": "Post status"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "blog",
        "webinar",
        "speaking",
        "manual"
      ],
      "description": "What triggered this post"
    },
    "source_id": {
      "type": "string",
      "description": "ID of the source entity"
    },
    "source_title": {
      "type": "string",
      "description": "Title of the source content"
    },
    "scheduled_at": {
      "type": "string",
      "description": "When to publish"
    },
    "published_at": {
      "type": "string",
      "description": "When it was actually published"
    },
    "platform_post_id": {
      "type": "string",
      "description": "ID returned from the platform after publishing"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if publishing failed"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hashtags to include"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Like/reaction count"
    },
    "comments": {
      "type": "number",
      "default": 0,
      "description": "Comment count"
    },
    "shares": {
      "type": "number",
      "default": 0,
      "description": "Share/repost count"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Click count (link clicks)"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Impression/reach count"
    },
    "metrics_updated_at": {
      "type": "string",
      "description": "When metrics were last fetched"
    }
  },
  "required": [
    "platform",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}