{
  "name": "ExecutiveBriefing",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Executive name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Executive email"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "title": {
      "type": "string",
      "description": "Executive title"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "preferred_date": {
      "type": "string",
      "format": "date",
      "description": "Preferred briefing date"
    },
    "preferred_time": {
      "type": "string",
      "description": "Preferred time"
    },
    "topics_of_interest": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topics they want to discuss"
    },
    "current_challenges": {
      "type": "string",
      "description": "Current security challenges"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "virtual",
        "in-person"
      ],
      "default": "virtual",
      "description": "Preferred meeting type"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "requested",
      "description": "Briefing status"
    },
    "scheduled_datetime": {
      "type": "string",
      "description": "Actual scheduled date and time"
    },
    "meeting_notes": {
      "type": "string",
      "description": "Notes from the briefing"
    },
    "description": {
      "type": "string",
      "description": "Additional context or admin notes about this briefing",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "email",
    "company",
    "title",
    "preferred_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {}
  },
  "x-base44-permissions": {
    "list": "admin",
    "get": "admin",
    "create": "public",
    "update": "admin",
    "delete": "admin"
  }
}