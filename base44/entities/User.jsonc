{
  "type": "object",
  "name": "User",
  "title": "User",
  "properties": {
    "email": {
      "type": "string",
      "description": "The email of the user"
    },
    "full_name": {
      "type": "string",
      "description": "The full name of the user"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "User role within the platform"
    },
    "hub_identity": {
      "type": "string",
      "description": "Cross-app identity token for PHD Hub ecosystem recognition"
    },
    "hub_apps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CyberDojoSensai",
          "ASOSINT",
          "PHDHub",
          "SentinelEcosystem"
        ]
      },
      "description": "List of dojo ecosystem apps this user is recognized in",
      "default": [
        "CyberDojoSensai"
      ]
    },
    "hub_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active",
      "description": "User status across the dojo ecosystem"
    },
    "last_hub_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Last time identity was synced across hub apps"
    }
  },
  "required": [
    "full_name",
    "last_hub_sync",
    "hub_identity",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}